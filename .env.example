# Google Sheets Database ID (already created for you!)
GOOGLE_SPREADSHEET_ID=1ZXGI2h9wErEprRag-yKT8gv6PpBXZoygiQQ59x_2gcI

# Option A (Recommended for Production): Google Cloud Service Account
# Share the spreadsheet with this service account email as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Option B (Fast 60-Second Alternative): Google Apps Script Web App Bridge
# Paste google-apps-script/Code.gs into Extensions -> Apps Script in your Sheet.
GOOGLE_APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=

# Cryptographic secret for signing HttpOnly session cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=
